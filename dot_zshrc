DOTFILES_DIR="${DOTFILES_TMP:-$HOME}"

if [ -z "$DOTFILES_TMP" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

alias vim='vim -u $DOTFILES_DIR/.vimrc'

# Prompt: Pure (zsh only, installed via npm), falling back to Starship when the
# npm install was unavailable. PURE_DIR mirrors the `--prefix` the installers
# pass to npm, which drops the package under <prefix>/lib/node_modules.
PURE_DIR="$DOTFILES_DIR/.local/lib/node_modules/pure-prompt"
if [ -d "$PURE_DIR" ]; then
    fpath+=("$PURE_DIR")
    autoload -U promptinit && promptinit
    prompt pure
elif command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Zoxide
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
    alias cd="z"
fi

# Aliases
if [ -f "$DOTFILES_DIR/.shell_aliases" ]; then
    source "$DOTFILES_DIR/.shell_aliases"
fi

# Machine-local overrides (not tracked in dotfiles)
if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi
